generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VIEWER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum InitiativeStatus {
  DRAFT
  ACTIVE
  PAUSED
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceType {
  ADAPTIVE
  CORRECTIVE
  EVOLUTIVE
}

enum EpicResolution {
  PARENT
  EPIC_LINK
  HIERARCHY
  UNRESOLVED
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum DemandStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  DONE
  DISCARDED
}

enum EmailResult {
  SENT
  DRY_RUN
  FAILED
}

enum IssueKind {
  EPIC
  STORY
  TASK
  OTHER
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  displayName  String
  passwordHash String
  role         UserRole        @default(VIEWER)
  status       UserStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  emails       EmailDispatch[]
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Objective {
  id          String             @id @default(cuid())
  name        String
  description String?            @db.Text
  active      Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  initiatives Initiative[]
  epics       Epic[]
  demands     ImpulsiveDemand[]
}

model Initiative {
  id          String            @id @default(cuid())
  name        String
  description String?           @db.Text
  objectiveId String?
  objective   Objective?        @relation(fields: [objectiveId], references: [id])
  status      InitiativeStatus  @default(ACTIVE)
  priority    Priority          @default(MEDIUM)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  epics       Epic[]
  demands     ImpulsiveDemand[]

  @@index([objectiveId])
}

model Subarea {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  active    Boolean            @default(true)
  sortOrder Int                @default(0)
  people    Person[]
  demands   ImpulsiveDemand[]
}

model ServiceFamily {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  active    Boolean            @default(true)
  sortOrder Int                @default(0)
  people    Person[]
  demands   ImpulsiveDemand[]
}

model ActivityType {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  system    Boolean  @default(false)
  epics     Epic[]
}

model Person {
  id              String          @id @default(cuid())
  accountId       String          @unique
  displayName     String
  email           String?
  active          Boolean         @default(true)
  subareaId       String?
  subarea         Subarea?        @relation(fields: [subareaId], references: [id])
  serviceFamilyId String?
  serviceFamily   ServiceFamily?  @relation(fields: [serviceFamilyId], references: [id])
  lastSeenAt      DateTime?
  assignedIssues  Issue[]         @relation("IssueAssignee")
  worklogs        Worklog[]

  @@index([subareaId])
  @@index([serviceFamilyId])
}

model JiraProject {
  id           String    @id @default(cuid())
  jiraId       String    @unique
  key          String
  name         String
  activeInJira Boolean   @default(true)
  lastSyncedAt DateTime?
}

model Board {
  id           String   @id @default(cuid())
  jiraId       String   @unique
  name         String
  type         String?
  projectKey   String?
  activeInJira Boolean  @default(true)
  sprints      Sprint[]
}

model Sprint {
  id           String        @id @default(cuid())
  jiraId       String        @unique
  boardId      String?
  board        Board?        @relation(fields: [boardId], references: [id])
  name         String
  state        String
  startDate    DateTime?
  endDate      DateTime?
  activeInJira Boolean       @default(true)
  issues       IssueSprint[]
  worklogs     Worklog[]
  currentFor   Issue[]       @relation("CurrentSprint")

  @@index([boardId])
}

model Epic {
  id                String           @id @default(cuid())
  jiraIssueId       String           @unique
  key               String
  summary           String
  description       String?          @db.Text
  statusName        String
  statusCategory    String
  assigneeAccountId String?
  assigneeName      String?
  initiativeId      String?
  initiative        Initiative?      @relation(fields: [initiativeId], references: [id])
  objectiveId       String?
  objective         Objective?       @relation(fields: [objectiveId], references: [id])
  objectiveExplicit Boolean          @default(false)
  maintenanceType   MaintenanceType?
  activityTypeId    String?
  activityType      ActivityType?    @relation(fields: [activityTypeId], references: [id])
  originalSeconds   Int              @default(0)
  spentSeconds      Int              @default(0)
  remainingSeconds  Int              @default(0)
  storyPoints       Float?
  jiraUrl           String
  activeInJira      Boolean          @default(true)
  lastSyncedAt      DateTime?
  issues            Issue[]
  demands           ImpulsiveDemand[]

  @@index([key])
  @@index([initiativeId])
  @@index([activityTypeId])
}

model Issue {
  id               String         @id @default(cuid())
  jiraIssueId      String         @unique
  key              String
  summary          String
  description      String?        @db.Text
  issueType        String
  kind             IssueKind
  statusName       String
  statusCategory   String
  epicId           String?
  epic             Epic?          @relation(fields: [epicId], references: [id])
  epicResolution   EpicResolution
  assigneeId       String?
  assignee         Person?        @relation("IssueAssignee", fields: [assigneeId], references: [id])
  currentSprintId  String?
  currentSprint    Sprint?        @relation("CurrentSprint", fields: [currentSprintId], references: [id])
  inBacklog        Boolean        @default(false)
  originalSeconds  Int            @default(0)
  spentSeconds     Int            @default(0)
  remainingSeconds Int            @default(0)
  storyPoints      Float?
  createdAtJira    DateTime?
  resolvedAt       DateTime?
  jiraUrl          String
  activeInJira     Boolean        @default(true)
  lastSyncedAt     DateTime?
  sprints          IssueSprint[]
  worklogs         Worklog[]

  @@index([key])
  @@index([epicId])
  @@index([kind])
  @@index([statusCategory])
  @@index([assigneeId])
}

model IssueSprint {
  issueId  String
  sprintId String
  issue    Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sprint   Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@id([issueId, sprintId])
}

model Worklog {
  id          String   @id @default(cuid())
  jiraId      String   @unique
  issueId     String
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  personId    String?
  person      Person?  @relation(fields: [personId], references: [id])
  accountId   String
  displayName String
  seconds     Int
  startedAt   DateTime
  sprintId    String?
  sprint      Sprint?  @relation(fields: [sprintId], references: [id])

  @@index([issueId])
  @@index([accountId])
  @@index([sprintId])
}

model ImpulsiveDemand {
  id              String          @id @default(cuid())
  title           String
  description     String?         @db.Text
  requester       String
  occurredAt      DateTime
  priority        Priority        @default(MEDIUM)
  estimatedHours  Float           @default(0)
  initiativeId    String?
  initiative      Initiative?     @relation(fields: [initiativeId], references: [id])
  objectiveId     String?
  objective       Objective?      @relation(fields: [objectiveId], references: [id])
  subareaId       String?
  subarea         Subarea?        @relation(fields: [subareaId], references: [id])
  serviceFamilyId String?
  serviceFamily   ServiceFamily?  @relation(fields: [serviceFamilyId], references: [id])
  status          DemandStatus    @default(NEW)
  epicId          String?
  epic            Epic?           @relation(fields: [epicId], references: [id])
  jiraKey         String?
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([occurredAt])
  @@index([initiativeId])
}

model SyncRun {
  id         String     @id @default(cuid())
  status     SyncStatus
  trigger    String
  mode       String
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  error      String?    @db.Text
  stats      Json?

  @@index([startedAt])
}

model EmailDispatch {
  id         String      @id @default(cuid())
  sentAt     DateTime    @default(now())
  recipient  String
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  issueCount Int
  result     EmailResult
  error      String?     @db.Text
  kinds      String

  @@index([sentAt])
}
