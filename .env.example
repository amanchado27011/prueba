# Copiar a .env (no commitear secretos).

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/gestion_demanda"

PORT=3000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV=development

# Firma JWT de esta aplicación. No usar aquí el token de Jira.
JWT_SECRET="change-me-min-16-chars-dev-only"
JWT_EXPIRES_IN="8h"
BCRYPT_ROUNDS=10

AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Jira Cloud, solo lectura (email + API token). Nunca se envían al frontend.
# JIRA_BASE_URL="https://tu-org.atlassian.net"
# JIRA_EMAIL="cuenta-tecnica@empresa.com"
# JIRA_API_TOKEN=""
# Claves separadas por coma. Vacío = proyectos visibles para la cuenta, con tope.
# JIRA_PROJECT_KEYS=""
JIRA_MAX_PROJECTS=30
JIRA_MAX_ISSUES=5000
JIRA_PAGE_SIZE=50
JIRA_MIN_INTERVAL_MS=150
# Permite el botón de sincronización simulada fuera de producción.
JIRA_ALLOW_FIXTURE=true

# Antigüedad a partir de la cual el panel marca los datos como desactualizados.
STALE_AFTER_HOURS=24

# Correo de IT.PIME. También se puede sobrescribir en Configuración si hay sesión ADMIN.
# IT_PIME_EMAIL="it.pime@empresa.com"
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="gestion-demanda@empresa.com"
# SMTP_SECURE=false

# Seed de desarrollo.
SEED_ADMIN_EMAIL="admin@gestion-demanda.local"
SEED_ADMIN_PASSWORD="ChangeMeDemo!23"
SEED_ADMIN_NAME="Administración"
